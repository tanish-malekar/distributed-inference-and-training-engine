{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Context3: Check GPUs (read-only)",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/context3.sh",
        "check"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      }
    },
    {
      "label": "Context3: Set up and sync (no GPU)",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/context3.sh",
        "setup"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      }
    },
    {
      "label": "Context3: Fine-tune one step (confirmation required)",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/context3.sh",
        "run",
        "${input:gpus}",
        "1",
        "--dp",
        "${input:dp}",
        "--tp",
        "${input:tp}",
        "--pp",
        "${input:pp}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      }
    },
    {
      "label": "Context3: Generate text (confirmation required)",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/context3.sh",
        "infer",
        "${input:gpus}",
        "--model",
        "${input:model}",
        "--prompt",
        "${input:prompt}",
        "--dp",
        "${input:dp}",
        "--tp",
        "${input:tp}",
        "--pp",
        "${input:pp}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      }
    },
    {
      "label": "Context3: Parallel smoke test (confirmation required)",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/context3.sh",
        "smoke",
        "${input:gpus}",
        "--output",
        "${input:smokeOutput}",
        "--dp",
        "${input:dp}",
        "--tp",
        "${input:tp}",
        "--pp",
        "${input:pp}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      }
    }
  ],
  "inputs": [
    {
      "id": "gpus",
      "type": "promptString",
      "default": "0",
      "description": "GPU index, or comma-separated list (e.g. 0,1). Check nvidia-smi first; the terminal will ask for confirmation. The count must equal dp*tp*pp."
    },
    {
      "id": "dp",
      "type": "promptString",
      "default": "1",
      "description": "Data-parallel replicas"
    },
    {
      "id": "tp",
      "type": "promptString",
      "default": "1",
      "description": "Tensor-parallel ways (SmolLM2: 1 or 3)"
    },
    {
      "id": "pp",
      "type": "promptString",
      "default": "1",
      "description": "Pipeline stages"
    },
    {
      "id": "smokeOutput",
      "type": "promptString",
      "default": "outputs/parallel-smoke",
      "description": "Fresh remote output directory for the smoke test"
    },
    {
      "id": "model",
      "type": "promptString",
      "description": "HF model ID or remote checkpoint directory",
      "default": "HuggingFaceTB/SmolLM2-135M"
    },
    {
      "id": "prompt",
      "type": "promptString",
      "description": "Text to continue",
      "default": "The purpose of machine learning is"
    }
  ]
}
